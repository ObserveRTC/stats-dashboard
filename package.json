{
  "name": "observertc-stats",
  "version": "1.0.0",
  "description": "Dashboard for observer-js ClientSample streams and mediasoup router samples: per-client WebRTC reports, SFU mapping and call-level diagnostics.",
  "license": "Apache-2.0",
  "author": "ObserveRTC",
  "homepage": "https://observertc.org/",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:router-mapping": "node --experimental-strip-types scripts/routerServerData.test.ts",
    "test:fixture": "node --experimental-strip-types scripts/realFixture.test.ts",
    "test": "npm run test:no-write-path && npm run test:offline-build && npm run test:router-mapping && npm run test:fixture && npm run test:joins && npm run test:issue-lanes && npm run test:transport-timeline && npm run test:score-explanation && npm run test:call-summary && npm run test:tab-visibility && npm run test:csv && npm run test:sample-reasons && npm run test:router-entities && npm run test:call-dashboard && npm run test:worker-requests && npm run test:ice-candidate-story && npm run test:storage-config && npm run test:digest-schema && npm run test:digest-model && npm run test:proxy-streams && npm run test:sample-patch && npm run test:help && npm run test:check-catalogue && npm run test:digest-patch && npm run test:digest-server && npm run test:digest-navigation && npm run test:overview-quality",
    "test:joins": "node --experimental-strip-types scripts/clientJoins.test.ts",
    "test:issue-lanes": "node --experimental-strip-types scripts/issueLanes.test.ts",
    "test:transport-timeline": "node --experimental-strip-types scripts/transportTimeline.test.ts",
    "test:score-explanation": "node --experimental-strip-types scripts/scoreExplanation.test.ts",
    "test:call-summary": "node --experimental-strip-types scripts/callSummaryMerge.test.ts",
    "test:tab-visibility": "node --experimental-strip-types scripts/tabVisibility.test.ts",
    "test:csv": "node --experimental-strip-types scripts/csvExport.test.ts",
    "test:sample-reasons": "node --experimental-strip-types scripts/sampleScoreReasons.test.ts",
    "test:router-entities": "node --experimental-strip-types scripts/routerEntityTimeline.test.ts",
    "test:call-dashboard": "node --experimental-strip-types scripts/callDashboard.test.ts",
    "test:worker-requests": "node --experimental-strip-types scripts/workerRequests.test.ts",
    "test:ice-candidate-story": "node --experimental-strip-types scripts/iceCandidateStory.test.ts",
    "test:storage-config": "node --experimental-strip-types scripts/storageConfig.test.ts",
    "test:digest-schema": "node --experimental-strip-types scripts/digestSchema.test.ts",
    "test:digest-model": "node --experimental-strip-types scripts/digestModel.test.ts",
    "test:help": "node --experimental-strip-types scripts/help.test.ts",
    "test:proxy-streams": "node --experimental-strip-types scripts/proxyStreams.test.ts",
    "schema:generate": "node digest-schema/scripts/generate.mjs",
    "schema:check": "node digest-schema/scripts/generate.mjs --check",
    "test:sample-patch": "node scripts/samplePatch.test.mjs",
    "test:no-write-path": "node --experimental-strip-types scripts/noWritePath.test.ts",
    "test:offline-build": "node --experimental-strip-types scripts/offlineBuild.test.ts",
    "test:check-catalogue": "node --experimental-strip-types scripts/checkCatalogue.test.ts",
    "digest:probe": "node scripts/fixtureProbe.mjs",
    "test:digest-patch": "node src/digest-server/test/samplePatch.test.mjs",
    "test:digest-server": "node src/digest-server/test/callDigest.test.mjs",
    "digest": "node src/digest-server/cli.mjs",
    "digest:serve": "node src/digest-server/server.mjs",
    "digest:fixture": "node src/digest-server/test/makeFixture.mjs",
    "docker:digest": "docker build -f Dockerfile.digest -t observertc/digest-server:local .",
    "test:digest-navigation": "node --experimental-strip-types scripts/digestNavigation.test.ts",
    "test:overview-quality": "node --experimental-strip-types scripts/overviewQuality.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "d3": "^7.9.0",
    "html-to-image": "^1.11.13",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3"
  }
}

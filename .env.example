# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Object storage (S3-compatible) ─────────────────────────────────────────
#
# Works with AWS S3, MinIO, Cloudflare R2, Backblaze B2, etc.

# Endpoint — omit for AWS S3 (SDK uses the default regional endpoint).
# MinIO:         http://localhost:9000
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Bucket name
S3_BUCKET=

# AWS region — us-east-1 works for MinIO/R2 (they ignore it)
S3_REGION=us-east-1

# Credentials (server-side only — never sent to the browser)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Use path-style URLs: true for MinIO/self-hosted, false for AWS S3 / R2
S3_FORCE_PATH_STYLE=true

# Endpoint to sign browser-facing URLs against, when it differs from S3_ENDPOINT.
#
# The server reads storage itself, but presigned URLs are followed by the
# browser — and a signature is bound to the host it was made for. Set this when
# the two reach storage by different names: an internal VPC endpoint vs a public
# one, or `http://minio:9000` inside a container network vs `http://localhost:9000`
# from the user's machine. Leave blank when they are the same, which is usual.
S3_PUBLIC_ENDPOINT=

# How long presigned GET URLs stay valid (seconds). Default: 900 (15 min)
# S3_PRESIGN_TTL=900

# ── Server ──────────────────────────────────────────────────────────────────
# Port and bind address. The container defaults to 3000 on 0.0.0.0.
# PORT=3000
# HOSTNAME=0.0.0.0

# ── Next.js API ─────────────────────────────────────────────────────────────
# Leave blank — /api/* routes are served from the same origin as the app.
#
# NOTE: this is the one setting that is NOT runtime-configurable. `NEXT_PUBLIC_*`
# values are inlined into the browser bundle when the image is built, so changing
# it needs a rebuild (`--build-arg NEXT_PUBLIC_API_BASE_URL=…`). Blank — same
# origin — is what almost every deployment wants, which is why it is the default.
NEXT_PUBLIC_API_BASE_URL=

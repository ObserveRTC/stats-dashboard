# ── Object storage (S3-compatible) ─────────────────────────────────────────

S3_ENDPOINT=http://192.168.50.156:30090
S3_BUCKET=observertc-samples
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

